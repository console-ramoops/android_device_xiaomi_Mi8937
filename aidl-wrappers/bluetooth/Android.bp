cc_binary {
    name: "android.hardware.bluetooth-service.xiaomi",
    relative_install_path: "hw",
    init_rc: ["android.hardware.bluetooth-service.xiaomi.rc"],
    vintf_fragments: ["android.hardware.bluetooth-service.xiaomi.xml"],
    srcs: [
        "BluetoothHci.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
        "android.hardware.bluetooth-V1-ndk",
        "android.hardware.bluetooth@1.0",
    ],
    vendor: true,
}
