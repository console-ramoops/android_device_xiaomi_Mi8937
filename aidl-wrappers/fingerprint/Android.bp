cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.xiaomi-wrapper",
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.fingerprint-service.xiaomi-wrapper.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.xiaomi-wrapper.xml"],
    srcs: [
        "BiometricsFingerprintAidl.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.fingerprint@2.1",
    ],
    vendor: true,
}
