        "libcutils",
        "liblog",
        "libhidlbase",
        "libhardware",
        "libutils",
        "android.hardware.biometrics.fingerprint@2.1",
    ],
}

prebuilt_etc {
    name: "android.hardware.biometrics.fingerprint@2.1-service.xiaomi_wt8937.rc",
    src: "android.hardware.biometrics.fingerprint@2.1-service.xiaomi_wt8937.rc",
